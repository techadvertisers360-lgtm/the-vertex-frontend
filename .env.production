# Production build defaults (Vercel). Public values only — no secrets here.
# Vercel Environment Variables with the same names override these.

# Backend on Vercel: Next.js rewrites /api/* to it, so login cookies stay first-party on the frontend domain.
BACKEND_URL=https://thevertexhealthbackend.vercel.app

# Live updates on Vercel go through Supabase Realtime (set NEXT_PUBLIC_SUPABASE_URL and
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY in Vercel). Without them the app falls back to 30 s polling.
NEXT_PUBLIC_REALTIME_PROVIDER=supabase

NEXT_PUBLIC_APP_TIMEZONE=Asia/Karachi
