# Backend origin used by Next.js rewrites for /api/* (server-side; not exposed to the browser)
BACKEND_URL=http://localhost:4000
# Socket.IO origin the browser connects to (must be allowed by backend FRONTEND_ORIGIN CORS)
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
# Clinic timezone used for all date display / input
NEXT_PUBLIC_APP_TIMEZONE=Asia/Karachi

# Live updates transport: socketio (local, default) or supabase (Vercel). See docs/VERCEL_SUPABASE_SETUP.md
NEXT_PUBLIC_REALTIME_PROVIDER=socketio
# Only for supabase mode — public values (Project URL + publishable/anon key); never the secret key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
